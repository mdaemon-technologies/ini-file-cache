{
  "name": "@mdaemon/ini-file-cache",
  "version": "3.0.0",
  "description": "A library for reading, writing, and watching ini files for changes",
  "type": "module",
  "main": "dist/iniFileCache.cjs",
  "module": "dist/iniFileCache.mjs",
  "typings": "dist/iniFileCache.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run && npm run test:smoke",
    "dev-test": "vitest",
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite build --watch",
    "pub": "npm run build && npm run test && npm publish",
    "test:smoke": "node --test smoke/smoke.test.cjs smoke/smoke.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdaemon-technologies/ini-file-cache.git"
  },
  "keywords": [
    "ini",
    "file",
    "cache",
    "caching",
    "read",
    "write"
  ],
  "author": {
    "name": "MDaemon Technologies, Ltd.",
    "email": "jonathan.ehman@mdaemon.com",
    "url": "https://www.mdaemon.com"
  },
  "license": "LGPL-2.1",
  "engines": {
    "node": ">=16"
  },
  "bugs": {
    "url": "https://github.com/mdaemon-technologies/ini-file-cache/issues"
  },
  "homepage": "https://github.com/mdaemon-technologies/ini-file-cache#readme",
  "devDependencies": {
    "@types/node": "^25.9.0",
    "terser": "^5.51.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@mdaemon/emitter": "^3.1.0"
  },
  "files": [
    "dist/iniFileCache.*",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/iniFileCache.d.ts",
        "default": "./dist/iniFileCache.mjs"
      },
      "require": {
        "types": "./dist/iniFileCache.d.cts",
        "default": "./dist/iniFileCache.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "types": "dist/iniFileCache.d.ts"
}
